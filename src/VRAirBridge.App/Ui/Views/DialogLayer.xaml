<UserControl x:Class="VRAirBridge.App.Ui.Views.DialogLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VRAirBridge.App.Ui.Controls"
             xmlns:v="clr-namespace:VRAirBridge.App.Ui.Views"
             Focusable="False">
    <!-- In-app dialog: scrim + centred card. DataContext is a DialogHostVm. -->
    <Grid x:Name="Overlay" Visibility="Collapsed" c:FadeShow.IsShown="{Binding IsOpen}" c:FadeShow.Duration="0.14"
          KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
          KeyboardNavigation.DirectionalNavigation="Cycle">
        <Border x:Name="Scrim" Background="{DynamicResource B.Scrim}" MouseLeftButtonDown="OnScrimClick" />
        <v:DialogCard x:Name="Card" DataContext="{Binding Current}" Margin="24"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      BodyMaxHeight="{Binding ActualHeight, ElementName=Scrim, Converter={StaticResource Mul}, ConverterParameter=0.6}"
                      Visibility="Collapsed" c:FadeShow.IsShown="{Binding DataContext.IsOpen, ElementName=Overlay}"
                      c:FadeShow.Offset="10" c:FadeShow.Duration="0.15" />
    </Grid>
</UserControl>
