<UserControl x:Class="VRAirBridge.App.Ui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VRAirBridge.App.Ui.Controls"
             xmlns:l="clr-namespace:VRAirBridge.App.Ui"
             xmlns:vm="clr-namespace:VRAirBridge.App.Ui.ViewModels"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="ColHdr" TargetType="TextBlock" BasedOn="{StaticResource T.Caption}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource Btn.Plain}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="c:Btn.IconSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <c:StableScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <!-- LastMinHeight: small enough that every dashboard state fits the default 1200x780 window without the page
             scrolling (checked by the layout pass of ui-screenshot); below that the page scrolls instead. -->
        <c:FillLastPanel Margin="16,14,16,14" Gap="12" LastMinHeight="112">

            <!-- ======================================================== hotspot + channel -->
            <c:AdaptiveGrid MinColumnWidth="340" MaxColumns="2" Gap="12">

                <!-- hotspot -->
                <c:SectionCard Margin="0" Header="{l:T ui.dash.hotspot}" Icon="{StaticResource I.wifi}">
                    <c:SectionCard.HeaderExtra>
                        <StackPanel Orientation="Horizontal">
                            <c:Pill Text="{Binding FullText}" Tone="{Binding FullTone}" />
                            <c:IconView Style="{StaticResource HelpIcon}" ToolTip="{l:T ui.dash.fullTip}" />
                        </StackPanel>
                    </c:SectionCard.HeaderExtra>
                    <StackPanel>
                        <!-- headline / detail -->
                        <TextBlock Text="{Binding Headline, Converter={StaticResource Disp}}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding Detail, Converter={StaticResource Disp}}" Style="{StaticResource T.Dim}"
                                   Visibility="{Binding Detail, Converter={StaticResource EmptyVis}}" />

                        <!-- hints -->
                        <Border Margin="0,10,0,0" Style="{StaticResource Callout}"
                                Visibility="{Binding HasHints, Converter={StaticResource BoolVis}}">
                            <DockPanel>
                                <c:IconView DockPanel.Dock="Left" Size="15" Margin="0,1,9,0" VerticalAlignment="Top"
                                            Data="{StaticResource I.triangle-alert}" Foreground="{DynamicResource B.Warn}" />
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding HintItems}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,1" Text="{Binding Converter={StaticResource Disp}}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- weak D-Link reception: where to plug it in -->
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal"
                                                Visibility="{Binding ShowUsbTip, Converter={StaticResource BoolVis}}">
                                        <StackPanel Width="150" Margin="0,0,16,0">
                                            <Viewbox Height="56" HorizontalAlignment="Center">
                                                <Canvas Width="120" Height="80">
                                                    <!-- hub with a keyboard, a mic and a drive plugged in next to the D-Link -->
                                                    <Line X1="33" Y1="30" X2="33" Y2="6" Stroke="{DynamicResource B.TextDim}" StrokeThickness="2" />
                                                    <Line X1="51" Y1="30" X2="51" Y2="10" Stroke="{DynamicResource B.TextDim}" StrokeThickness="2" />
                                                    <Line X1="87" Y1="30" X2="87" Y2="4" Stroke="{DynamicResource B.TextDim}" StrokeThickness="2" />
                                                    <Rectangle Canvas.Left="64" Canvas.Top="11" Width="11" Height="20" RadiusX="2" RadiusY="2" Fill="{DynamicResource B.Accent}" />
                                                    <Rectangle Canvas.Left="18" Canvas.Top="30" Width="84" Height="22" RadiusX="5" RadiusY="5"
                                                               Fill="{DynamicResource B.Surface}" Stroke="{DynamicResource B.TextDim}" StrokeThickness="1.5" />
                                                    <Line X1="60" Y1="52" X2="60" Y2="76" Stroke="{DynamicResource B.TextDim}" StrokeThickness="2" />
                                                    <c:IconView Canvas.Left="100" Canvas.Top="0" Size="20" Data="{StaticResource I.circle-x}" Foreground="{DynamicResource B.Bad}" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Margin="0,4,0,0" Text="{l:T ui.rx.picBad}" Style="{StaticResource T.Dim}" FontSize="11"
                                                       TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Width="150">
                                            <Viewbox Height="56" HorizontalAlignment="Center">
                                                <Canvas Width="120" Height="80">
                                                    <!-- back of the PC: the D-Link straight in a motherboard port -->
                                                    <Rectangle Canvas.Left="34" Canvas.Top="4" Width="52" Height="72" RadiusX="4" RadiusY="4"
                                                               Fill="{DynamicResource B.Surface}" Stroke="{DynamicResource B.TextDim}" StrokeThickness="1.5" />
                                                    <Rectangle Canvas.Left="42" Canvas.Top="10" Width="18" Height="40" RadiusX="1" RadiusY="1"
                                                               Stroke="{DynamicResource B.TextDim}" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="46" Canvas.Top="15" Width="10" Height="4" Stroke="{DynamicResource B.TextDim}" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="46" Canvas.Top="29" Width="10" Height="4" Stroke="{DynamicResource B.TextDim}" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="46" Canvas.Top="36" Width="10" Height="4" Stroke="{DynamicResource B.TextDim}" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="66" Canvas.Top="12" Width="12" Height="56" RadiusX="1" RadiusY="1"
                                                               Stroke="{DynamicResource B.TextDim}" StrokeThickness="1" />
                                                    <Rectangle Canvas.Left="20" Canvas.Top="20" Width="28" Height="8" RadiusX="2" RadiusY="2" Fill="{DynamicResource B.Accent}" />
                                                    <c:IconView Canvas.Left="100" Canvas.Top="0" Size="20" Data="{StaticResource I.circle-check}" Foreground="{DynamicResource B.Good}" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Margin="0,4,0,0" Text="{l:T ui.rx.picGood}" Style="{StaticResource T.Dim}" FontSize="11"
                                                       TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Divider}" />

                        <!-- name / band -->
                        <TextBlock Text="{Binding HotspotTitle, Converter={StaticResource Disp}}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0" Text="{Binding HotspotSubtitle, Converter={StaticResource Disp}}" Style="{StaticResource T.Dim}" />

                        <!-- metrics (the USB picture above takes their place: they say nothing useful while the D-Link can barely hear) -->
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Metrics}" Focusable="False"
                                      Visibility="{Binding ShowUsbTip, Converter={StaticResource BoolVisInv}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <c:AdaptiveGrid MinColumnWidth="118" MaxColumns="4" Gap="8" Balanced="True" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MetricVm}">
                                    <Border CornerRadius="8" Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.CardBorder}"
                                            BorderThickness="1" Padding="10,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <c:IconView DockPanel.Dock="Left" Size="13" Margin="0,0,6,0"
                                                            Data="{Binding Icon, Converter={StaticResource IconKey}}"
                                                            Foreground="{DynamicResource B.TextDim}" />
                                                <TextBlock Text="{Binding Label, Converter={StaticResource Disp}}" Style="{StaticResource T.Dim}" FontSize="11" />
                                            </DockPanel>
                                            <TextBlock Margin="0,4,0,0" Text="{Binding Value, Converter={StaticResource Disp}}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- details -->
                        <ToggleButton x:Name="DetailsToggle" Margin="-8,8,0,0" HorizontalAlignment="Left" Style="{StaticResource Btn.Plain}"
                                      IsChecked="{Binding HotspotDetailsOpen}" c:Btn.IconSize="14"
                                      c:Btn.Icon="{Binding HotspotDetailsOpen, Converter={StaticResource BoolIcon}, ConverterParameter=I.chevron-up|I.chevron-down}"
                                      Content="{l:T ui.dash.details}" />
                        <c:Reveal IsOpen="{Binding HotspotDetailsOpen}">
                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding HotspotRows}" ItemTemplate="{StaticResource KvRow}" Focusable="False" />
                        </c:Reveal>
                    </StackPanel>
                </c:SectionCard>

                <!-- channel -->
                <c:SectionCard Margin="0" Header="{l:T channel.groupTitle}" Icon="{StaticResource I.radio}">
                    <c:SectionCard.HeaderExtra>
                        <Button Style="{StaticResource SmallBtn}" Content="{l:T channel.scanButton}" c:Btn.Icon="{StaticResource I.scan-eye}"
                                ToolTip="{l:T channel.scanTooltip}" IsEnabled="{Binding CanScan}" Command="{Binding ScanCommand}" />
                    </c:SectionCard.HeaderExtra>
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding ChannelRows}" ItemTemplate="{StaticResource KvRow}" Focusable="False" />

                        <StackPanel Visibility="{Binding ShowPinSection, Converter={StaticResource BoolVis}}">
                            <Border Style="{StaticResource Divider}" />
                            <DockPanel>
                                <c:Pill DockPanel.Dock="Right" Text="{l:T ui.ch.experimental}" Tone="Warn" ShowDot="False" />
                                <!-- icon docked to the right of the label so it never wraps onto a line of its own -->
                                <DockPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <c:IconView DockPanel.Dock="Right" Style="{StaticResource HelpIcon}" VerticalAlignment="Center" ToolTip="{l:T channel.pinWhat}" />
                                    <TextBlock Text="{l:T channel.pinLabel}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                            </DockPanel>
                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding PinItems}" SelectedItem="{Binding SelectedPin}"
                                      IsDropDownOpen="{Binding PinDropDownOpen}" DisplayMemberPath="Text" IsEnabled="{Binding CanOps}"
                                      AutomationProperties.Name="{l:T channel.pinLabel}" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding PinText, Converter={StaticResource Disp}}" TextWrapping="Wrap"
                                       Foreground="{Binding PinTone, Converter={StaticResource ToneBrush}}"
                                       Visibility="{Binding PinText, Converter={StaticResource EmptyVis}}" />
                            <Border Margin="0,8,0,0" Style="{StaticResource Callout}">
                                <TextBlock Text="{l:T channel.pinWarning}" TextWrapping="Wrap" FontSize="11.5" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </c:SectionCard>
            </c:AdaptiveGrid>

            <!-- ======================================================== devices -->
            <c:SectionCard Margin="0" Header="{l:T ui.devices.title}" Icon="{StaticResource I.smartphone}">
                <c:SectionCard.HeaderExtra>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DevicesSummary}" Style="{StaticResource T.Dim}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        <Button x:Name="QrButton" Margin="0,0,4,0" Style="{StaticResource SmallBtn}" c:Btn.Icon="{StaticResource I.qr-code}"
                                Content="{l:T ui.qr.button}" ToolTip="{l:T ui.qr.buttonTip}" Command="{Binding ShowQrCommand}" />
                        <Button Style="{StaticResource Btn.Icon}" Width="26" Height="26" c:Btn.Icon="{StaticResource I.copy}" c:Btn.IconSize="14"
                                ToolTip="{l:T ui.devices.copy}" AutomationProperties.Name="{l:T ui.devices.copy}"
                                Command="{Binding CopyDeviceCommand}"
                                Visibility="{Binding HasDevices, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </c:SectionCard.HeaderExtra>
                <Grid>
                    <!-- empty state -->
                    <StackPanel Margin="0,6,0,6" HorizontalAlignment="Center"
                                Visibility="{Binding HasDevices, Converter={StaticResource BoolVisInv}}">
                        <c:IconView Size="26" Data="{StaticResource I.smartphone}" Foreground="{DynamicResource B.Muted}" />
                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Text="{l:T ui.devices.none}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="520"
                                   Text="{Binding DevicesEmptyHint, Converter={StaticResource Disp}}" Style="{StaticResource T.Dim}" />
                    </StackPanel>

                    <!-- list -->
                    <Grid Visibility="{Binding HasDevices, Converter={StaticResource BoolVis}}" Grid.IsSharedSizeScope="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="28,0,6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24*" MinWidth="70" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DevMac" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DevIp" />
                                <ColumnDefinition Width="14*" MinWidth="48" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DevSeen" />
                                <ColumnDefinition Width="20*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource ColHdr}" Text="{l:T ui.devices.colName}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ColHdr}" Text="{l:T ui.devices.colMac}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource ColHdr}" Text="{l:T ui.devices.colIp}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource ColHdr}" Text="{l:T ui.devices.colState}" />
                            <TextBlock Grid.Column="4" Style="{StaticResource ColHdr}" Text="{l:T ui.devices.colLastSeen}" />
                            <TextBlock Grid.Column="5" Style="{StaticResource ColHdr}" Text="{l:T ui.devices.colNote}" />
                        </Grid>
                        <ListBox Grid.Row="1" MaxHeight="260" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                 AutomationProperties.Name="{l:T ui.devices.title}">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:T ui.devices.copy}" Command="{Binding CopyDeviceCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceRowVm}">
                                    <DockPanel>
                                        <c:StatusDot DockPanel.Dock="Left" Tone="{Binding DotTone}" Radius="4" Margin="2,0,8,0" VerticalAlignment="Center" />
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24*" MinWidth="70" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DevMac" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DevIp" />
                                                <ColumnDefinition Width="14*" MinWidth="48" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DevSeen" />
                                                <ColumnDefinition Width="20*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Cell}" Text="{Binding Name, Converter={StaticResource Disp}}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding Mac}" FontFamily="{DynamicResource F.Mono}" FontSize="11.5" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding Ip}" TextWrapping="NoWrap"
                                                       Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="{Binding State, Converter={StaticResource Disp}}"
                                                       Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                            <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Text="{Binding LastSeen}" Foreground="{DynamicResource B.TextDim}" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="5" Style="{StaticResource Cell}" Text="{Binding Note, Converter={StaticResource Disp}}" Foreground="{DynamicResource B.TextDim}" />
                                            <!-- what to do about a failed join: one full-width line under the row -->
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="6" Margin="0,2,10,1" Style="{StaticResource Cell}"
                                                       Text="{Binding Hint, Converter={StaticResource Disp}}" Foreground="{DynamicResource B.TextDim}"
                                                       Visibility="{Binding Hint, Converter={StaticResource EmptyVis}}" />
                                        </Grid>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </c:SectionCard>

            <!-- ======================================================== log (fills the rest) -->
            <ContentControl Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="12,6,8,6" MinHeight="26">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Margin="0,0,10,0" VerticalAlignment="Center" Content="{l:T ui.log.showDebug}" MaxWidth="340"
                                      IsChecked="{Binding ShowDebugLog}"
                                      Visibility="{Binding IsAdvanced, Converter={StaticResource BoolVis}}" />
                            <Button Style="{StaticResource SmallBtn}" Content="{l:T ui.log.copyAll}" c:Btn.Icon="{StaticResource I.copy}"
                                    Command="{Binding CopyLogCommand}" />
                            <Button Style="{StaticResource SmallBtn}" Content="{l:T ui.log.clear}" c:Btn.Icon="{StaticResource I.x}"
                                    Command="{Binding ClearLogCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <c:IconView Size="16" Margin="0,0,9,0" Data="{StaticResource I.scroll-text}" Foreground="{DynamicResource B.IconAccent}" />
                            <TextBlock Text="{l:T ui.log.title}" FontWeight="SemiBold" FontSize="12.6" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource B.Divider}">
                        <Grid>
                            <TextBlock Margin="14,12" Text="{l:T ui.log.empty}" Style="{StaticResource T.Dim}"
                                       Visibility="{Binding HasLog, Converter={StaticResource BoolVisInv}}" />
                            <ListBox x:Name="LogList" Padding="6,4" ItemsSource="{Binding LogLines}" SelectionMode="Extended"
                                     FontFamily="{DynamicResource F.Mono}" FontSize="11.5"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     VirtualizingPanel.CacheLengthUnit="Item" VirtualizingPanel.CacheLength="6"
                                     ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="{l:T ui.log.title}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="6,1" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T ui.log.copySelected}" Command="{Binding CopyLogCommand}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="{l:T ui.log.copyAll}" Command="{Binding CopyLogCommand}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LogLineVm}">
                                        <TextBlock Text="{Binding Text, Converter={StaticResource Disp}}" TextWrapping="Wrap"
                                                   Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </ContentControl>
        </c:FillLastPanel>
    </c:StableScrollViewer>
</UserControl>
