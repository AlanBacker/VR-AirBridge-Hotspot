<!--
    VR Air Bridge Hotspot: control styles in the design language of VRChat-DLSS5-Cam.
    Every colour is a DynamicResource "B.*" brush that ThemeManager mutates in place (animated dark/light blend).
    Metrics: window / card / popup radius 10, frames 6, tooltips / toasts 8; frame height 28; font 12 DIP.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:VRAirBridge.App.Ui.Controls"
                    xmlns:l="clr-namespace:VRAirBridge.App.Ui"
                    xmlns:vm="clr-namespace:VRAirBridge.App.Ui.ViewModels">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================================================ converters -->
    <l:ToneBrushConverter x:Key="ToneBrush" />
    <l:BoolToVisibility x:Key="BoolVis" />
    <l:BoolToVisibility x:Key="BoolVisInv" Invert="True" />
    <l:EmptyToCollapsed x:Key="EmptyVis" />
    <l:EmptyToCollapsed x:Key="EmptyVisInv" Invert="True" />
    <l:NotConverter x:Key="Not" />
    <l:MultiplyConverter x:Key="Mul" />
    <l:BoolToIconConverter x:Key="BoolIcon" />
    <l:IconKeyConverter x:Key="IconKey" />
    <!-- display-only shaping (Korean keep-all, non-breaking hyphens) for wrapping text; never for automation names -->
    <l:DisplayTextConverter x:Key="Disp" />

    <!-- ============================================================ focus ring -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="8" RadiusY="8" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource B.Focus}" StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ text -->
    <Style x:Key="T.Dim" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="T.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="T.Welcome" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17.4" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="T.Tile" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="T.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.3" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="T.Wrap" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- "?" help icon with a tooltip -->
    <Style x:Key="HelpIcon" TargetType="c:IconView">
        <Setter Property="Data" Value="{StaticResource I.circle-question-mark}" />
        <Setter Property="Size" Value="14" />
        <Setter Property="IsHelp" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource B.Help}" />
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="120" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource B.HelpHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ buttons -->
    <ControlTemplate x:Key="BtnTpl" TargetType="ButtonBase">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Bg" CornerRadius="{Binding (c:Btn.Radius), RelativeSource={RelativeSource TemplatedParent}}"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" />
            <Border x:Name="Hov" Opacity="0" CornerRadius="{Binding (c:Btn.Radius), RelativeSource={RelativeSource TemplatedParent}}"
                    Background="{DynamicResource B.HoverTint}" />
            <Border x:Name="Prs" Opacity="0" CornerRadius="{Binding (c:Btn.Radius), RelativeSource={RelativeSource TemplatedParent}}"
                    Background="{DynamicResource B.PressTint}" />
            <DockPanel Margin="{TemplateBinding Padding}" LastChildFill="True"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <c:IconView x:Name="Ico" DockPanel.Dock="Left" Margin="0,0,7,0"
                            Data="{Binding (c:Btn.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                            Size="{Binding (c:Btn.IconSize), RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter x:Name="Cp" VerticalAlignment="Center" RecognizesAccessKey="False" />
            </DockPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="c:Btn.Icon" Value="{x:Null}">
                <Setter TargetName="Ico" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Ico" Property="Margin" Value="0" />
                <Setter TargetName="Cp" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hov" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Prs" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Prs" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Btn.Base" TargetType="ButtonBase">
        <Setter Property="Template" Value="{StaticResource BtnTpl}" />
        <Setter Property="Background" Value="{DynamicResource B.Control}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="450" />
        <Setter Property="ToolTipService.ShowDuration" Value="30000" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Btn.Base}" />
    <Style x:Key="Btn.Flat" TargetType="Button" BasedOn="{StaticResource Btn.Base}" />

    <Style x:Key="Btn.Accent" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{DynamicResource B.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{DynamicResource B.BadSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Bad}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.GhostBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="Btn.Plain" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
        <Setter Property="Padding" Value="8,4" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Btn.Icon" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Plain}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
    </Style>

    <DataTemplate x:Key="WrapText">
        <TextBlock Text="{Binding Converter={StaticResource Disp}}" TextWrapping="Wrap" />
    </DataTemplate>
    <!-- WrapText for string content only; element content is presented as is -->
    <l:StringTemplateSelector x:Key="WrapStrings" StringTemplate="{StaticResource WrapText}" />

    <!-- Full-width row button (maintenance actions): icon + wrapping label, left aligned. -->
    <Style x:Key="Btn.Row" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="ContentTemplateSelector" Value="{StaticResource WrapStrings}" />
    </Style>

    <Style x:Key="Btn.Link" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.Link}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="T" Background="Transparent" TextWrapping="Wrap">
                        <Run Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={StaticResource Disp}}" />
                    </TextBlock>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section-card header hit area -->
    <Style x:Key="SectionHeaderToggle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Margin="3" CornerRadius="8" Background="Transparent" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.SectionHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.SectionPress}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ switch (CheckBox) -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="ContentTemplateSelector" Value="{StaticResource WrapStrings}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Cp" Margin="0,0,12,0" VerticalAlignment="Center" RecognizesAccessKey="False">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Grid Grid.Column="1" Width="36" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource B.ToggleOff}" />
                            <Border x:Name="On" CornerRadius="10" Background="{DynamicResource B.Accent}" Opacity="0" />
                            <Border x:Name="Ring" Margin="-3" CornerRadius="13" BorderThickness="2"
                                    BorderBrush="{DynamicResource B.Focus}" Visibility="Collapsed" />
                            <Ellipse x:Name="Knob" Width="15" Height="15" Margin="2.5,0,0,0" HorizontalAlignment="Left"
                                     VerticalAlignment="Center" Fill="{DynamicResource B.Knob}" Effect="{DynamicResource E.Knob}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="16" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource B.ToggleOffHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Cp" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ text input -->
    <ControlTemplate x:Key="InputTpl" TargetType="Control">
        <Border x:Name="Bd" CornerRadius="6" SnapsToDevicePixels="True"
                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ControlHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Control}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Background" Value="{DynamicResource B.Control}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource B.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource B.TextSelection}" />
        <Setter Property="SelectionOpacity" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource InputTpl}" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Background" Value="{DynamicResource B.Control}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource B.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource B.TextSelection}" />
        <Setter Property="SelectionOpacity" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource InputTpl}" />
    </Style>

    <!-- ============================================================ scrolling -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Margin="2" CornerRadius="3" Background="{DynamicResource B.ScrollThumb}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ScrollThumbActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" MinHeight="24" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPage}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" MinWidth="24" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPage}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Cursor="Arrow"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Cursor="Arrow"
                                   Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ tooltip -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MaxWidth" Value="400" />
        <Setter Property="ContentTemplateSelector" Value="{StaticResource WrapStrings}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid Margin="8,4,8,12">
                        <Border CornerRadius="8" Background="{DynamicResource B.PopupBg}" Effect="{DynamicResource E.Popup}" />
                        <Border CornerRadius="8" BorderBrush="{DynamicResource B.CardBorder}" BorderThickness="1" Padding="10,7">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ combo box -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="6" Background="{DynamicResource B.Control}" />
                        <Border x:Name="Hov" CornerRadius="6" Background="{DynamicResource B.HoverTint}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hov" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource B.ControlActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="9,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="MaxDropDownHeight" Value="360" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Tg" Style="{StaticResource ComboToggle}" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <DockPanel Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <c:IconView DockPanel.Dock="Right" Margin="6,0,0,0" Size="14" Data="{StaticResource I.chevron-down}"
                                        Foreground="{DynamicResource B.TextDim}" />
                            <c:IconView x:Name="Lead" DockPanel.Dock="Left" Margin="0,0,7,0" Size="16"
                                        Data="{Binding (c:Btn.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
                            <TextBlock x:Name="Short" DockPanel.Dock="Left" Margin="5,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold"
                                       Text="{Binding (c:Btn.ShortText), RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </DockPanel>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade" VerticalOffset="0" HorizontalOffset="-8"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid Margin="8,2,8,14" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                  MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border CornerRadius="8" Background="{DynamicResource B.PopupBg}" Effect="{DynamicResource E.Popup}" />
                                <Border CornerRadius="8" BorderBrush="{DynamicResource B.CardBorder}" BorderThickness="1" Padding="4">
                                    <ScrollViewer c:SmoothScroll.IsEnabled="True" CanContentScroll="False">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Btn.Icon" Value="{x:Null}">
                            <Setter TargetName="Lead" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Tag" Value="compact">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Lead" Property="Margin" Value="0" />
                            <Setter TargetName="Short" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="c:Btn.ShortText" Value="{x:Null}">
                            <Setter TargetName="Short" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Selection}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ context menu -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="8,4,8,14">
                        <Border CornerRadius="8" Background="{DynamicResource B.PopupBg}" Effect="{DynamicResource E.Popup}" />
                        <Border CornerRadius="8" BorderBrush="{DynamicResource B.CardBorder}" BorderThickness="1" Padding="4">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" MinWidth="160" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" CornerRadius="5" Background="Transparent" Padding="6,6,12,6">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="22">
                                <ContentPresenter x:Name="Ico" ContentSource="Icon" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <c:IconView x:Name="Chk" Size="14" Data="{StaticResource I.check}" HorizontalAlignment="Left"
                                            Foreground="{DynamicResource B.IconAccent}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chk" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ico" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,4" Background="{DynamicResource B.Divider}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ lists -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" c:SmoothScroll.IsEnabled="False"
                                  CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.AltRow}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Selection}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ custom controls -->
    <Style TargetType="c:SectionCard">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SectionCard">
                    <Grid>
                        <Border CornerRadius="10" Background="{DynamicResource B.Card}" Effect="{DynamicResource E.Card}" />
                        <Border CornerRadius="10" Background="{DynamicResource B.Card}" BorderBrush="{DynamicResource B.CardBorder}" BorderThickness="1">
                            <StackPanel>
                                <Grid MinHeight="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Hdr" Grid.ColumnSpan="3" Style="{StaticResource SectionHeaderToggle}"
                                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <DockPanel Margin="12,6,8,6" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <c:IconView DockPanel.Dock="Left" Margin="0,0,9,0" Size="16" Data="{TemplateBinding Icon}"
                                                    Foreground="{DynamicResource B.IconAccent}" />
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextBlock.FontWeight="SemiBold"
                                                          TextBlock.FontSize="12.6" RecognizesAccessKey="False">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </DockPanel>
                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="0,4"
                                                      Content="{TemplateBinding HeaderExtra}" />
                                    <c:IconView x:Name="Chev" Grid.Column="2" Margin="8,0,13,0" Size="14" IsHitTestVisible="False"
                                                Data="{StaticResource I.chevron-down}" Foreground="{DynamicResource B.TextDim}"
                                                Rotation="{Binding Progress, ElementName=PART_Reveal, Converter={StaticResource Mul}, ConverterParameter=180}" />
                                </Grid>
                                <c:Reveal x:Name="PART_Reveal" IsOpen="{TemplateBinding IsExpanded}">
                                    <ContentPresenter Margin="12,0,12,12" />
                                </c:Reveal>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCollapsible" Value="False">
                            <Setter TargetName="Chev" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Hdr" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="Hdr" Property="Focusable" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:Segmented">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Segmented">
                    <Border CornerRadius="8" Background="{DynamicResource B.Control}" Padding="3">
                        <Grid x:Name="PART_Host">
                            <Border x:Name="PART_Thumb" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="{DynamicResource B.SegThumb}" Visibility="Hidden" />
                            <ItemsPresenter />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:SegmentedItem">
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SegmentedItem">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:Pill">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Pill">
                    <Border CornerRadius="11" Padding="9,3" VerticalAlignment="Center"
                            Background="{Binding Tone, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ToneBrush}, ConverterParameter=soft}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Fill="{Binding Tone, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ToneBrush}, ConverterParameter=dot}" />
                            <TextBlock Text="{TemplateBinding Text}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{Binding Tone, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ToneBrush}}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowDot" Value="False">
                            <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ shared templates -->
    <!-- Key / value row: the value column starts at 42 % of the width; both sides wrap instead of clipping. -->
    <DataTemplate x:Key="KvRow" DataType="{x:Type vm:KvItem}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42*" />
                <ColumnDefinition Width="58*" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,10,0" Text="{Binding Label, Converter={StaticResource Disp}}" Foreground="{DynamicResource B.TextDim}"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" Text="{Binding Value, Converter={StaticResource Disp}}" TextWrapping="Wrap" ToolTip="{Binding Tip}"
                       Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
        </Grid>
    </DataTemplate>

    <!-- Callout box (hints / warnings): tone picks the tint. -->
    <Style x:Key="Callout" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource B.WarnBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.WarnBorder}" />
    </Style>

    <!-- Plain card: shadow layer + bordered surface (the shadow sits on its own layer so text stays ClearType-crisp). -->
    <Style x:Key="Card" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="{DynamicResource B.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.CardBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="10" Background="{TemplateBinding Background}" Effect="{DynamicResource E.Card}" />
                        <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Read-only, selectable multi-line text (dialog result lines, Meta leftovers). -->
    <Style x:Key="Box.ReadOnly" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Field label above an input. -->
    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,10,0,4" />
    </Style>

    <!-- Thin divider line inside cards. -->
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource B.Divider}" />
        <Setter Property="Margin" Value="0,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
</ResourceDictionary>
